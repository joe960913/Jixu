{
  "name": "jixu-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:packages": "tsc -b tsconfig.build.json && node scripts/copy-package-assets.ts",
    "build:cli": "pnpm run build:packages && node scripts/build-cli-artifact.ts",
    "clean:packages": "tsc -b tsconfig.build.json --clean",
    "pack:packages": "node scripts/package-artifacts.ts --out .artifacts/packages",
    "dev": "pnpm run build:packages && bun run packages/jixu/src/cli.tsx",
    "typecheck": "pnpm run build:packages && tsc --noEmit",
    "test": "pnpm run build:packages && node --test",
    "test:tui": "pnpm run build:packages && pnpm --filter jixu test:tui",
    "test:packages": "node scripts/verify-package-portability.ts",
    "lint": "node scripts/lint.ts",
    "check": "pnpm run build:packages && tsc --noEmit && pnpm run lint && node --test && pnpm --filter jixu test:tui",
    "check:release": "pnpm run check && pnpm run test:packages"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@publint/pack": "0.1.6",
    "@types/node": "24.13.2",
    "@types/react": "19.2.18",
    "publint": "0.3.23",
    "typescript": "6.0.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
