{
  "name": "jixu-ai",
  "version": "0.1.0-beta.0",
  "description": "The Jixu Agent Framework facade and installable TUI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe960913/Jixu.git",
    "directory": "packages/jixu"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "jixu": "./dist/cli-bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --workspace-root run build:packages && bun run src/cli.tsx",
    "test:tui": "bun run test/tui-smoke.tsx",
    "build:executable": "pnpm --workspace-root run build:cli",
    "update:tree-sitter": "bun run scripts/update-tree-sitter-assets.ts"
  },
  "dependencies": {
    "jixu-core": "workspace:*"
  },
  "optionalDependencies": {
    "jixu-cli-darwin-arm64": "workspace:*",
    "jixu-cli-darwin-x64": "workspace:*",
    "jixu-cli-linux-x64": "workspace:*"
  },
  "devDependencies": {
    "jixu-llm": "workspace:*",
    "jixu-store-jsonl": "workspace:*",
    "jixu-tools-jina": "workspace:*",
    "jixu-tools-node": "workspace:*",
    "@opentui/core": "0.5.4",
    "@opentui/react": "0.5.4",
    "react": "19.2.8",
    "react-devtools-core": "7.0.1",
    "ws": "8.21.3"
  }
}
