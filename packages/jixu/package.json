{
  "name": "jixu",
  "version": "0.0.0",
  "description": "The public Jixu library facade.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe960913/Jixu.git",
    "directory": "packages/jixu"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --workspace-root run build:packages && bun run src/cli.tsx",
    "test:tui": "bun run test/tui-smoke.tsx",
    "build:executable": "pnpm --workspace-root run build:packages && bun build --compile src/cli.tsx --outfile dist/jixu",
    "update:tree-sitter": "bun run scripts/update-tree-sitter-assets.ts"
  },
  "dependencies": {
    "@jixu/core": "workspace:*"
  },
  "devDependencies": {
    "@jixu/llm": "workspace:*",
    "@jixu/store-jsonl": "workspace:*",
    "@jixu/tools-node": "workspace:*",
    "@opentui/core": "0.5.4",
    "@opentui/react": "0.5.4",
    "react": "19.2.8",
    "react-devtools-core": "7.0.1",
    "ws": "8.21.3"
  }
}
