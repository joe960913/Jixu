{
  "name": "jixu-ai",
  "version": "0.4.0",
  "description": "Jixu framework entry point and installable native TUI.",
  "keywords": [
    "ai-agent",
    "agent-harness",
    "agent-framework",
    "context-engineering",
    "single-agent",
    "durable-execution",
    "event-sourcing",
    "tui",
    "cli",
    "typescript"
  ],
  "homepage": "https://jixu.dev",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe960913/Jixu.git",
    "directory": "packages/jixu"
  },
  "bugs": {
    "url": "https://github.com/joe960913/Jixu/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "!dist/jixu",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "jixu": "./dist/cli-bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --workspace-root run build:packages && bun run src/cli.tsx",
    "test:tui": "bun run test/tui-smoke.tsx",
    "build:executable": "pnpm --workspace-root run build:cli",
    "update:tree-sitter": "bun run scripts/update-tree-sitter-assets.ts"
  },
  "dependencies": {
    "jixu-core": "workspace:*",
    "jixu-tools-jina": "workspace:*",
    "jixu-tools-node": "workspace:*"
  },
  "optionalDependencies": {
    "jixu-cli-darwin-arm64": "workspace:*",
    "jixu-cli-linux-x64": "workspace:*"
  },
  "devDependencies": {
    "@opentui/core": "0.5.4",
    "@opentui/react": "0.5.4",
    "fast-png": "8.0.0",
    "jixu-llm": "workspace:*",
    "jixu-store-jsonl": "workspace:*",
    "react": "19.2.8",
    "react-devtools-core": "7.0.1",
    "ws": "8.21.3"
  }
}
